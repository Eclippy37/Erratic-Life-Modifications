{
    "hidden": true,
    "type": "origins:multiple",
    "primary": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:if_else",
            "if_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:execute_command",
                        "command": "function life:quirk/kirby/teleport"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "playsound minecraft:block.note_block.bit player @s ~ ~ ~ 0.8 1"
                    },
                    {
                        "type": "origins:change_resource",
                        "resource": "*:quirk/misc/base_active",
                        "operation": "set",
                        "change": 99999
                    }
                ]
            },
            "else_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:execute_command",
                        "command": "title @s actionbar {\"text\":\"There are no Kirbys in this world\",\"bold\":true,\"color\":\"red\"}"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                    },
                    {
                        "type": "origins:change_resource",
                        "resource": "*:quirk/misc/base_active",
                        "operation": "set",
                        "change": 99999
                    }
                ]
            },
            "condition": {
                "type": "origins:command",
                "command": "execute if entity @e[tag=kirby]",
                "comparison": ">=",
                "compare_to": 1
            }
        },
        "cooldown": 20,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 1,
            "inverted": true,
            "order": 1
        }
    },
    "base": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.kirby"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.kirby"
        }
    }
}