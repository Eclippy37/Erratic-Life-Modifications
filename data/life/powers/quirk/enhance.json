{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:if_else",
            "if_action": {
                "type": "origins:raycast",
                "block": false,
                "entity": true,
                "shape_type": "collider",
                "fluid_handling": "none",
                "hit_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:change_resource",
                            "resource": "*:*_cooldown_1",
                            "operation": "set",
                            "change": 99999
                        },
                        {
                            "type": "origins:change_resource",
                            "resource": "*:*_cooldown_2",
                            "operation": "set",
                            "change": 0
                        },
                        {
                            "type": "origins:change_resource",
                            "resource": "*:quirk/misc/base_active",
                            "operation": "set",
                            "change": 99999
                        }
                    ]
                },
                "bientity_action": {
                    "type": "origins:target_action",
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:change_resource",
                                "resource": "*:quirk/misc/base_enhanced",
                                "operation": "set",
                                "change": 99999
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:wildlife_time_speed_up player @a ~ ~ ~ 0.8 2"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:quirk/misc/base_active",
                                "operation": "set",
                                "change": 0
                            }
                        ]
                    }
                },
                "miss_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:execute_command",
                            "command": "title @s actionbar \"You are not looking at a player\""
                        },
                        {
                            "type": "origins:execute_command",
                            "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                        }
                    ]
                }
            },
            "else_action": {
                "type": "origins:area_of_effect",
                "radius": 7,
                "bientity_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "*:quirk/misc/base_enhanced",
                                        "operation": "set",
                                        "change": 99999
                                    },
                                    {
                                        "type": "origins:execute_command",
                                        "command": "playsound minecraft:wildlife_time_speed_up player @a ~ ~ ~ 0.8 2"
                                    },
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "*:quirk/misc/base_active",
                                        "operation": "set",
                                        "change": 0
                                    }
                                ]
                            }
                        },
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "*:*_cooldown_1",
                                        "operation": "set",
                                        "change": 0
                                    },
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "*:*_cooldown_2",
                                        "operation": "set",
                                        "change": 99999
                                    }
                                ]
                            }
                        }
                    ]
                },
                "bientity_condition": {
                    "type": "origins:and",
                    "conditions": [
                        {
                            "type": "origins:target_condition",
                            "condition": {
                                "type": "origins:entity_type",
                                "entity_type": "minecraft:player"
                            }
                        },
                        {
                            "type": "origins:target_condition",
                            "condition": {
                                "type": "origins:gamemode",
                                "gamemode": "spectator",
                                "inverted": true
                            }
                        },
                        {
                            "type": "origins:target_condition",
                            "condition": {
                                "type": "origins:gamemode",
                                "gamemode": "creative",
                                "inverted": true
                            }
                        }
                    ]
                },
                "include_actor": false
            },
            "condition": {
                "type": "origins:sneaking",
                "inverted": true
            }
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_cooldown_1",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_cooldown_2",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        },
        "hud_render": {
            "should_render": false
        },
        "cooldown": 3
    },
    "cooldown_1": {
        "type": "origins:resource",
        "min": 0,
        "max": 2000,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "life:textures/gui/community/eclipse37/resource_bar_01.png",
            "bar_index": 0,
            "inverted": false,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "*:*_cooldown_1",
                        "comparison": ">",
                        "compare_to": 0
                    },
                    {
                        "type": "origins:resource",
                        "resource": "*:quirk/misc/base_erased",
                        "comparison": "==",
                        "compare_to": 0
                    }
                ]
            }
        }
    },
    "cooldown_1_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_cooldown_1",
            "operation": "add",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_cooldown_1",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "cooldown_2": {
        "type": "origins:resource",
        "min": 0,
        "max": 6000,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "life:textures/gui/community/eclipse37/resource_bar_01.png",
            "bar_index": 0,
            "inverted": false,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "*:*_cooldown_2",
                        "comparison": ">",
                        "compare_to": 0
                    },
                    {
                        "type": "origins:resource",
                        "resource": "*:quirk/misc/base_erased",
                        "comparison": "==",
                        "compare_to": 0
                    }
                ]
            }
        }
    },
    "cooldown_2_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_cooldown_2",
            "operation": "add",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_cooldown_2",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "base": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.enhance"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.enhance"
        }
    }
}