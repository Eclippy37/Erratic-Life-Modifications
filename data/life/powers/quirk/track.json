{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:if_else_list",
            "actions": [
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:raycast",
                                "block": false,
                                "entity": true,
                                "shape_type": "collider",
                                "fluid_handling": "none",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:actor_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function life:quirk/track/actor/hit"
                                            }
                                        },
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function life:quirk/track/target/hit"
                                            }
                                        }
                                    ]
                                },
                                "miss_action": {
                                    "type": "origins:execute_command",
                                    "command": "function life:quirk/track/actor/miss"
                                }
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:sneaking",
                        "inverted": true
                    }
                },
                {
                    "action": {
                        "type": "origins:execute_command",
                        "command": "function life:quirk/track/actor/clear"
                    },
                    "condition": {
                        "type": "origins:sneaking",
                        "inverted": false
                    }
                }
            ]
        },
        "cooldown": 1
    },
    "tick_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:execute_command",
            "command": "function life:quirk/track/tick"
        },
        "interval": 1
    },
    "glow": {
        "type": "origins:entity_glow",
        "entity_condition": {
            "type": "origins:nbt",
            "nbt": "{Tags:['quirk.track.target']}"
        },
        "bientity_condition": {
            "type": "origins:distance",
            "comparison": "<=",
            "compare_to": 128
        }
    },
    "remove": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "function life:quirk/track/clear_full"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "function life:quirk/track/clear_full"
        }
    },
    "death": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:execute_command",
                        "command": "function life:quirk/track/clear_full"
                    }
                ]
            }
        }
    },
    "active_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:quirk/misc/base_active",
            "operation": "set",
            "change": 100
        },
        "interval": 10,
        "condition": {
            "type": "origins:command",
            "command": "execute if entity @a[tag=quirk.track.target]",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "base": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.track"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.track"
        }
    }
}