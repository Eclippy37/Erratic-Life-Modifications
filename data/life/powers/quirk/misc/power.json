            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "operation": "add",
            "change": -1
        },
        "interval": 10,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "remove": {
        "type": "origins:action_on_callback",
