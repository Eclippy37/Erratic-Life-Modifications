{
    "hidden": true,
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 8,
        "min_action": {
            "type": "origins:execute_command",
            "command": "tag @s[tag=quirk.active] remove quirk.active"
        },
        "max_action": {
            "type": "origins:execute_command",
            "command": "tag @s[tag=!quirk.active] add quirk.active"
        },
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "resource_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "operation": "add",
            "change": -1
        },
        "interval": 10,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "remove": {
        "type": "origins:action_on_callback",
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.active"
        }
    },
    "death": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:change_resource",
                "resource": "*:*_resource",
                "operation": "set",
                "change": 0
            }
        }
    }
}