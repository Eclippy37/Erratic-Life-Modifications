{
    "hidden": true,
    "type": "origins:multiple",
    "timer": {
        "type": "origins:resource",
        "min": 0,
        "max": 1200,
        "start_value": 1200,
        "min_action": {
            "type": "origins:execute_command",
            "command": "function life:quirk/void/exit"
        },
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_03.png",
            "bar_index": 7,
            "inverted": false
        }
    },
    "timer_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_timer",
            "operation": "add",
            "change": -1
        },
        "interval": 1
    },
    "remove_on_leave": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:remove_power",
            "power": "life:quirk/dim/void"
        },
        "interval": 10,
        "condition": {
            "type": "origins:dimension",
            "dimension": "life:the_void",
            "inverted": true
        }
    },
    "feed_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:feed",
            "food": 10,
            "saturation": 10
        },
        "interval": 20
    }
}