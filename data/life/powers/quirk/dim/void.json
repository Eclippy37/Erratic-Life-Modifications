{
    "hidden": true,
    "type": "origins:multiple",
    "timer": {
        "type": "origins:resource",
        "min": 0,
        "max": 1200,
        "start_value": 1200,
        "min_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "if_action": {
                        "type": "origins:action_on_entity_set",
                        "set": "*:*_set",
                        "bientity_action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "tag @s add quirk.void.save.active"
                                    }
                                },
                                {
                                    "type": "origins:actor_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "execute in minecraft:overworld run tp @s @e[type=minecraft:marker,tag=quirk.void.save.active,limit=1,sort=nearest]"
                                    }
                                },
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "kill @e[type=minecraft:marker,tag=quirk.void.save.active,limit=1,sort=nearest]"
                                    }
                                },
                                {
                                    "type": "origins:remove_from_entity_set",
                                    "set": "*:*_set"
                                }
                            ]
                        }
                    },
                    "else_action": {
                        "type": "origins:execute_command",
                        "command": "execute in minecraft:overworld run spreadplayers ~ ~ 0 3 false @s"
                    },
                    "condition": {
                        "type": "origins:entity_set_size",
                        "set": "*:*_set",
                        "comparison": ">",
                        "compare_to": 0
                    }
                },
                {
                    "type": "origins:execute_command",
                    "command": "playsound minecraft:block.beacon.activate player @a ~ ~ ~ 1 1.5"
                },
                {
                    "type": "origins:execute_command",
                    "command": "playsound minecraft:entity.player.teleport player @a ~ ~ ~ 1 1"
                },
                {
                    "type": "origins:remove_power",
                    "power": "*:quirk/dim/void",
                    "source": "*:*"
                }
            ]
        },
        "hud_render": {
            "should_render": true,
            "sprite_location": "life:textures/gui/community/eclipse37/resource_bar_02.png",
            "bar_index": 11,
            "inverted": false
        }
    },
    "timer_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_timer",
            "operation": "add",
            "change": -1
        },
        "interval": 1
    },
    "remove_on_leave": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_timer",
            "operation": "set",
            "change": 0
        },
        "interval": 10,
        "condition": {
            "type": "origins:dimension",
            "dimension": "life:the_void",
            "inverted": true
        }
    },
    "feed_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:feed",
            "nutrition": 10,
            "saturation": 10
        },
        "interval": 20
    },
    "set": {
        "type": "origins:entity_set"
    }
}