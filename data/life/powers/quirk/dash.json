{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:add_velocity",
                                "y": 0.25
                            },
                            {
                                "type": "origins:add_velocity",
                                "z": 1.25,
                                "space": "local"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:entity.breeze.jump player @s ~ ~ ~ 0.8 1.25"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:entity.breeze.jump player @a[distance=0.01..] ~ ~ ~ 0.3 1.05"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:*_resource",
                                "operation": "add",
                                "change": -200
                            }
                        ]
                    },
                    "else_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:add_velocity",
                                "y": 0.75
                            },
                            {
                                "type": "origins:add_velocity",
                                "z": 12.5,
                                "space": "local"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:entity.breeze.jump player @s ~ ~ ~ 1.0 0.9"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:entity.breeze.jump player @a[distance=0.01..] ~ ~ ~ 0.5 0.85"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:*_resource",
                                "operation": "set",
                                "change": 0
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:quirk/misc/base_enhanced",
                                "operation": "set",
                                "change": 0
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:quirk/misc/base_enhanced",
                        "comparison": "==",
                        "compare_to": 0
                    }
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_fall_resource",
                    "operation": "set",
                    "change": 99999
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:quirk/misc/base_active",
                    "operation": "set",
                    "change": 99999
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_resource",
                    "comparison": ">=",
                    "compare_to": 200
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        },
        "cooldown": 1
    },
    "resource": {
        "hidden": true,
        "type": "origins:resource",
        "min": 0,
        "max": 700,
        "start_value": 700,
        "hud_render": {
            "should_render": true,
            "sprite_location": "life:textures/gui/community/eclipse37/resource_bar_02.png",
            "bar_index": 6,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "*:*_resource",
                        "comparison": "<",
                        "compare_to": 700
                    },
                    {
                        "type": "origins:resource",
                        "resource": "*:quirk/misc/base_erased",
                        "comparison": "==",
                        "compare_to": 0
                    }
                ]
            }
        }
    },
    "resource_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "operation": "add",
            "change": 1
        },
        "interval": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_resource",
                    "comparison": "<",
                    "compare_to": 700
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "no_fall": {
        "type": "origins:invulnerability",
        "damage_condition": {
            "type": "origins:name",
            "name": "fall"
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_fall_resource",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "fall_resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "reset_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_fall_resource",
            "operation": "set",
            "change": 0
        },
        "interval": 1,
        "condition": {
            "type": "origins:all_of",
            "conditions": [
                {
                    "type": "origins:on_block"
                },
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:lava",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_fall_resource",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        }
    },
    "death": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_resource",
                        "operation": "set",
                        "change": 99999
                    }
                ]
            }
        }
    },
    "base": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.dash"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.dash"
        }
    }
}