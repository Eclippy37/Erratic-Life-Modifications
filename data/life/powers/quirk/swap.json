{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:if_else_list",
            "actions": [
                {
                    "action": {
                        "type": "origins:raycast",
                        "block": false,
                        "entity": true,
                        "shape_type": "collider",
                        "fluid_handling": "none",
                        "bientity_action": {
                            "type": "origins:if_else",
                            "if_action": {
                                "type": "origins:if_else_list",
                                "actions": [
                                    {
                                        "action": {
                                            "type": "origins:and",
                                            "actions": [
                                                {
                                                    "type": "origins:actor_action",
                                                    "action": {
                                                        "type": "origins:and",
                                                        "actions": [
                                                            {
                                                                "type": "origins:execute_command",
                                                                "command": "playsound minecraft:block.note_block.chime player @s ~ ~ ~ 0.8 2"
                                                            },
                                                            {
                                                                "type": "origins:change_resource",
                                                                "resource": "*:quirk/misc/base_active",
                                                                "operation": "set",
                                                                "change": 100
                                                            }
                                                        ]
                                                    }
                                                },
                                                {
                                                    "type": "origins:add_to_entity_set",
                                                    "set": "*:*_set"
                                                }
                                            ]
                                        },
                                        "condition": {
                                            "type": "origins:in_entity_set",
                                            "set": "*:*_set",
                                            "inverted": true
                                        }
                                    },
                                    {
                                        "action": {
                                            "type": "origins:actor_action",
                                            "action": {
                                                "type": "origins:and",
                                                "actions": [
                                                    {
                                                        "type": "origins:execute_command",
                                                        "command": "title @s actionbar \"That player is already a target\""
                                                    },
                                                    {
                                                        "type": "origins:execute_command",
                                                        "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                                                    }
                                                ]
                                            }
                                        },
                                        "condition": {
                                            "type": "origins:in_entity_set",
                                            "set": "*:*_set",
                                            "inverted": false
                                        }
                                    }
                                ]
                            },
                            "else_action": {
                                "type": "origins:actor_action",
                                "action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:execute_command",
                                            "command": "title @s actionbar \"You are not looking at a player\""
                                        },
                                        {
                                            "type": "origins:execute_command",
                                            "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                                        }
                                    ]
                                }
                            },
                            "condition": {
                                "type": "origins:target_condition",
                                "condition": {
                                    "type": "origins:entity_type",
                                    "entity_type": "minecraft:player"
                                }
                            }
                        },
                        "miss_action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:execute_command",
                                    "command": "title @s actionbar \"You are not looking at a player\""
                                },
                                {
                                    "type": "origins:execute_command",
                                    "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                                }
                            ]
                        }
                    },
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:sneaking",
                                "inverted": true
                            },
                            {
                                "type": "origins:entity_set_size",
                                "set": "*:*_set",
                                "comparison": "<",
                                "compare_to": 2
                            }
                        ]
                    }
                },
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:action_on_entity_set",
                                "set": "*:*_set",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:remove_from_entity_set",
                                            "set": "*:*_set"
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:block.beacon.deactivate player @s ~ ~ ~ 0.8 1.25"
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:sneaking",
                                "inverted": false
                            },
                            {
                                "type": "origins:entity_set_size",
                                "set": "*:*_set",
                                "comparison": ">",
                                "compare_to": 0
                            }
                        ]
                    }
                },
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:action_on_entity_set",
                                "set": "*:*_set",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "tag @s add quirk.swap.target.active"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "origins:action_on_entity_set",
                                "set": "*:*_set",
                                "limit": 1,
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function life:quirk/swap/teleport"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "origins:action_on_entity_set",
                                "set": "*:*_set",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:remove_from_entity_set",
                                            "set": "*:*_set"
                                        },
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "tag @s remove quirk.swap.target.active"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "playsound minecraft:entity.player.teleport player @s ~ ~ ~ 0.8 1"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:*_cooldown",
                                "operation": "set",
                                "change": 2400
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:quirk/misc/base_active",
                                "operation": "set",
                                "change": 100
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:sneaking",
                                "inverted": true
                            },
                            {
                                "type": "origins:entity_set_size",
                                "set": "*:*_set",
                                "comparison": "==",
                                "compare_to": 2
                            }
                        ]
                    }
                }
            ]
        },
        "cooldown": 10,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_cooldown",
            "comparison": "==",
            "compare_to": 0
        }
    },
    "cooldown": {
        "type": "origins:resource",
        "min": 0,
        "max": 2400,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 1,
            "inverted": false,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_cooldown",
                "comparison": ">",
                "compare_to": 0,
                "inverted": false
            }
        }
    },
    "cooldown_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_cooldown",
            "operation": "add",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_cooldown",
            "comparison": ">",
            "compare_to": 0,
            "inverted": false
        }
    },
    "remove": {
	    "type": "origins:action_on_callback",
        "entity_action_respawned": {
            "type": "origins:action_on_entity_set",
            "set": "*:*_set",
            "bientity_action": {
                "type": "origins:remove_from_entity_set",
                "set": "*:*_set"
            }
        },
        "entity_action_lost": {
            "type": "origins:action_on_entity_set",
            "set": "*:*_set",
            "bientity_action": {
                "type": "origins:remove_from_entity_set",
                "set": "*:*_set"
            }
        }
    },
    "set": {
        "type": "origins:entity_set",
        "action_on_add": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:execute_command",
                "command": "tag @s add quirk.swap.target"
            }
        },
        "action_on_remove": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:execute_command",
                "command": "tag @s remove quirk.swap.target"
            }
        }
    },
    "set_glow": {
        "type": "origins:entity_glow",
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:can_see"
                },
                {
                    "type": "origins:distance",
                    "comparison": "<=",
                    "compare_to": 24
                },
                {
                    "type": "origins:in_entity_set",
                    "set": "*:*_set"
                }
            ]
        },
        "use_teams": false,
        "red": 0.333,
        "green": 0.0,
        "blue": 0.333
    },
    "death": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_cooldown",
                        "operation": "set",
                        "change": 0
                    },
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_resource",
                        "operation": "set",
                        "change": 0
                    }
                ]
            }
        }
    },
    "base": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.swap"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.swap"
        }
    }
}