    },
    "void_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:action_on_entity_set",
            "set": "*:*_set",
            "bientity_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:change_resource",
                            "resource": "*:*_timer",
                            "operation": "set",
                            "change": 0
                        }
                    },
                    {
                        "type": "origins:remove_from_entity_set",
                        "set": "*:*_set"
                    }
                ]
            },
            "bientity_condition" : {
                "type": "origins:target_condition",
                "condition": {
                    "type": "origins:and",
                    "conditions": [
                        {
                            "type": "origins:dimension",
                            "dimension": "life:the_void",
                            "inverted": true
                        }
                    ]
                }
            }
        },
        "interval": 1
    },
    "set": {
        "type": "origins:entity_set",
        "action_on_add": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:grant_power",
                        "power": "*:quirk/dim/void",
                        "source": "*:*"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "summon minecraft:marker ~ ~ ~ {Tags:[\"quirk.void.save\",\"quirk.void.save.created\"],data:{name:\"Quirk Void Save Point\"}}"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "playsound minecraft:entity.player.teleport player @a ~ ~ ~ 1 1"
                    },
                    {
                        "type": "origins:area_of_effect",
                        "radius": 0.001,
                        "bientity_action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:add_to_entity_set",
                                    "set": "*:quirk/dim/void_set"
                                },
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "tag @s remove quirk.void.save.created"
                                    }
                                }
                            ]
                        },
                        "bientity_condition": {
                            "type": "origins:target_condition",
                            "condition": {
                                "type": "origins:and",
                                "conditions": [
                                    {
                                        "type": "origins:entity_type",
                                        "entity_type": "minecraft:marker"
                                    },
                                    {
                                        "type": "origins:nbt",
                                        "nbt": "{Tags:[\"quirk.void.save\",\"quirk.void.save.created\"]}"
                                    }
                                ]
                            }
                        },
                        "include_actor": false
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "execute in life:the_void run tp 0 1 0"
                    }
                ]
            }
        },
        "action_on_remove": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:change_resource",
                "resource": "*:quirk/dim/void_timer",
                "operation": "set",
                "change": 0
            }
        }
    },
    "death": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_cooldown",
                        "operation": "set",
                        "change": 0
                    },
                    {
                        "type": "origins:if_else",
                        "if_action": {
                            "type": "origins:action_on_entity_set",
                            "set": "*:*_set",
                            "bientity_action": {
                                "type": "origins:remove_from_entity_set",
                                "set": "*:*_set"
                            }
                        },
                        "condition": {
                            "type": "origins:entity_set_size",
                            "set": "*:*_set",
                            "comparison": ">",
                            "compare_to": 0
                        }
                    }
                ]
            }
        }
    },
    "erased_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:if_else",
                        "if_action": {
                            "type": "origins:action_on_entity_set",
                            "set": "*:*_set",
                            "bientity_action": {
                                "type": "origins:remove_from_entity_set",
                                "set": "*:*_set"
                            }
                        },
                        "condition": {
                            "type": "origins:entity_set_size",
