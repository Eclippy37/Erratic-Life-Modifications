{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:if_else_list",
            "actions": [
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:raycast",
                                "block": false,
                                "entity": true,
                                "shape_type": "collider",
                                "fluid_handling": "none",
                                "hit_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "*:*_cooldown",
                                            "operation": "set",
                                            "change": 3600
                                        },
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "*:quirk/misc/base_active",
                                            "operation": "set",
                                            "change": 99999
                                        }
                                    ]
                                },
                                "bientity_action": {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "function life:quirk/void/enter"
                                    }
                                },
                                "miss_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:execute_command",
                                            "command": "title @s actionbar \"You are not looking at a player\""
                                        },
                                        {
                                            "type": "origins:execute_command",
                                            "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                                        }
                                    ]
                                },
                                "bientity_condition": {
                                    "type": "origins:target_condition",
                                    "condition": {
                                        "type": "origins:entity_type",
                                        "entity_type": "minecraft:player"
                                    }
                                }
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_cooldown",
                        "comparison": "==",
                        "compare_to": 0
                    }
                },
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "execute in life:the_void as @a[distance=0..] run resource set @s life:quirk/dim/void_timer 0"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "*:quirk/misc/base_active",
                                "operation": "set",
                                "change": 99999
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:command",
                        "command": "execute in life:the_void if entity @a[distance=0..]",
                        "comparison": "==",
                        "compare_to": 1
                    }
                }
            ]
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:quirk/misc/base_erased",
            "comparison": "==",
            "compare_to": 0
        },
        "cooldown": 5
    },
    "cooldown": {
        "type": "origins:resource",
        "min": 0,
        "max": 3600,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "life:textures/gui/community/eclipse37/resource_bar_01.png",
            "bar_index": 0,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "*:*_cooldown",
                        "comparison": ">",
                        "compare_to": 0
                    },
                    {
                        "type": "origins:resource",
                        "resource": "*:quirk/misc/base_erased",
                        "comparison": "==",
                        "compare_to": 0
                    }
                ]
            }
        }
    },
    "cooldown_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_cooldown",
            "operation": "add",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_cooldown",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:quirk/misc/base_erased",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "death": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_cooldown",
                        "operation": "set",
                        "change": 0
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "execute in life:the_void as @a[distance=0..] run resource set @s life:quirk/dim/void_timer 0"
                    }
                ]
            }
        }
    },
    "active_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:quirk/misc/base_active",
            "operation": "set",
            "change": 99999
        },
        "interval": 10,
        "condition": {
            "type": "origins:command",
            "command": "execute in life:the_void if entity @a[distance=0..]",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "base": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "*:quirk/misc/base",
            "source": "*:*"
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.void"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.void"
        }
    }
}