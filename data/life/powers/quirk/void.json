{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:active_self",
        "key": "key.origins.primary_active",
        "entity_action": {
            "type": "origins:if_else_list",
            "actions": [
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:raycast",
                                "block": false,
                                "entity": true,
                                "shape_type": "collider",
                                "fluid_handling": "none",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:actor_action",
                                            "action": {
                                                "type": "origins:change_resource",
                                                "resource": "*:*_cooldown",
                                                "operation": "set",
                                                "change": 3600
                                            }
                                        },
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function life:quirk/void/enter"
                                            }
                                        }
                                    ]
                                },
                                "miss_action": {
                                    "type": "origins:execute_command",
                                    "command": "function life:quirk/void/miss"
                                }
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_cooldown",
                        "comparison": "==",
                        "compare_to": 0
                    }
                },
                {
                    "action": {
                        "type": "origins:execute_command",
                        "command": "execute in life:the_void as @a[distance=0..] run resource set @s life:quirk/dim/void_timer 0"
                    },
                    "condition": {
                        "type": "origins:command",
                        "command": "execute in life:the_void if entity @a[distance=0..]",
                        "comparison": "==",
                        "compare_to": 1
                    }
                }
            ]
        },
        "cooldown": 10
    },
    "cooldown": {
        "type": "origins:resource",
        "min": 0,
        "max": 3600,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 1,
            "inverted": false,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_cooldown",
                "comparison": ">",
                "compare_to": 0,
                "inverted": false
            }
        }
    },
    "cooldown_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_cooldown",
            "operation": "add",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_cooldown",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "tag": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add quirk.void"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove quirk.void"
        }
    },
    "seek": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:grant_power",
            "power": "life:quirk/misc/power",
            "source": "*:*"
        },
        "entity_action_lost": {
            "type": "origins:remove_power",
            "power": "life:quirk/misc/power",
            "source": "*:*"
        }
    }
}