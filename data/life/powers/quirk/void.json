                            {
                                "type": "origins:raycast",
                                "block": false,
                                "entity": true,
                                "shape_type": "collider",
                                "fluid_handling": "none",
                                "hit_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "*:*_timer",
                                            "operation": "set",
                                            "change": 99999
                                        },
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "*:quirk/misc/base_active",
                                            "operation": "set",
                                            "change": 99999
                                        }
                                    ]
                                },
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "playsound minecraft:block.beacon.deactivate player @a ~ ~ ~ 1 0.5"
                                            }
                                        },
                                        {
                                            "type": "origins:add_to_entity_set",
                                            "set": "*:*_set"
                                        }
                                    ]
                                },
                                "miss_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:execute_command",
                                            "command": "title @s actionbar \"You are not looking at a player\""
                                        },
                                        {
                                            "type": "origins:execute_command",
                                            "command": "playsound minecraft:block.note_block.bass player @s ~ ~ ~ 0.8 1"
                                        }
                                    ]
                                },
                                "bientity_condition": {
                                    "type": "origins:target_condition",
                                    "condition": {
                                        "type": "origins:and",
                                        "conditions": [
                                            {
                                                "type": "origins:entity_type",
                                                "entity_type": "minecraft:player"
                                            },
                                            {
                                                "type": "origins:dimension",
                                                "dimension": "life:the_void",
                                                "inverted": true
                                            },
                                            {
                                                "type": "origins:dimension",
                                                "dimension": "life:dream",
                                                "inverted": true
                                            }
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:resource",
                                "resource": "*:*_cooldown",
                                "comparison": "==",
                                "compare_to": 0
                            },
                            {
                                "type": "origins:resource",
                                "resource": "*:*_timer",
                                "comparison": "==",
                                "compare_to": 0
                            }
                        ]
                    }
                },
                {
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:change_resource",
                                "resource": "*:*_timer",
                                "operation": "set",
                                "change": 0
                            },
                            {
                                "type": "origins:action_on_entity_set",
                                "set": "*:*_set",
                                "bientity_action": {
                                    "type": "origins:remove_from_entity_set",
                                    "set": "*:*_set"
                                }
                            }
                        ]
                    },
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:entity_set_size",
                                "set": "*:*_set",
                                "comparison": ">",
                                "compare_to": 0
                            },
                            {
                                "type": "origins:resource",
                                "resource": "*:*_timer",
                                "comparison": ">",
                                "compare_to": 0
                            }
                        ]
                    }
                }
            ]
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:quirk/misc/base_erased",
            "comparison": "==",
            "compare_to": 0
