{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:feed",
            "nutrition": 1,
            "saturation": 0.1
        },
        "condition": {
            "type": "origins:exposed_to_sun"
        },
        "interval": 30
    },
    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add vote.positive.sun_feed"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove vote.positive.sun_feed"
        }
    }
}