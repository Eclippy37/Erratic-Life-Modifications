{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:elytra_flight",
        "render_elytra": true
    },
    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add vote.positive.elytra"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove vote.positive.elytra"
        }
    }
}