{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:action_when_damage_taken",
        "entity_action": {
            "type": "origins:execute_command",
            "command": "spreadplayers ~ ~ 0 12 false @s"
        }
    },
    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add vote.negative.damage_tp"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove vote.negative.damage_tp"
        }
    }
}