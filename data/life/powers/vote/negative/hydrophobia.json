{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:damage_over_time",
        "interval": 20,
        "onset_delay": 1,
        "damage": 2,
        "damage_easy": 1,
        "damage_type": "origins:hurt_by_water",
        "condition": {
            "type": "origins:any_of",
            "conditions": [
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": ">",
                    "compare_to": 0.0
                },
                {
                    "type": "origins:in_rain"
                }
            ]
        }
    },
    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add vote.negative.hydrophobia"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove vote.negative.hydrophobia"
        }
    }
}