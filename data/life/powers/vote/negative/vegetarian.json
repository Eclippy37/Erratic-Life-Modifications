            "conditions": [
                {
                    "type": "origins:ingredient",
                    "ingredient": {
                        "tag": "origins:ignore_diet"
                    },
                    "inverted": true
                },
                {
                    "type": "origins:ingredient",
                    "ingredient": {
                        "tag": "origins:meat"
                    }
                },
                {
                    "type": "origins:food"
                }
            ]
        }
    },
    "callback": {
        "type": "origins:action_on_callback",
