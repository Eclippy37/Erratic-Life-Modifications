{
    "hidden": true,
    "type": "origins:multiple",
    "main": {
        "type": "origins:action_when_damage_taken",
        "entity_action": {
            "type": "origins:apply_effect",
            "effect": {
                "id": "minecraft:levitation",
                "duration": 60,
                "amplifier": 1,
                "ambient": false,
                "show_icon": false,
                "show_particles": true
            }
        },
        "damage_condition": {
            "type": "origins:type",
            "damage_type": "minecraft:fall",
            "inverted": true
        }
    },
    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:execute_command",
            "command": "tag @s add vote.negative.damage_levitation"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove vote.negative.damage_levitation"
        }
    }
}