{
    "hidden": true,
    "type": "origins:multiple",
    "no_fall": {
        "type": "origins:invulnerability",
        "damage_condition": {
            "type": "origins:name",
            "name": "fall"
        }
    },
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 3,
        "min_action": {
            "type": "origins:remove_power",
            "power": "*:*",
            "source": "*:*"
        },
        "start_value": 3,
        "hud_render": {
            "should_render": false
        }
    },
    "reset_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "operation": "add",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:all_of",
            "conditions": [
                {
                    "type": "origins:on_block"
                },
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:lava",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_resource",
                    "comparison": ">",
                    "compare_to": 0
                }
            ]
        }
    }
}