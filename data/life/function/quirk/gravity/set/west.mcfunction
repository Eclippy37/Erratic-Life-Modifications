# Set Tag
tag @s remove quirk.gravity.down
tag @s remove quirk.gravity.up
tag @s remove quirk.gravity.north
tag @s remove quirk.gravity.east
tag @s remove quirk.gravity.south
tag @s add quirk.gravity.west

# Set Gravity Direction
gravity set_base_direction west

# Playsound
playsound minecraft:block.beacon.activate player @s ~ ~ ~ 1 2