item replace entity @s hotbar.2 with iron_axe[enchantment_glint_override=false,enchantments={levels:{vanishing_curse:1},show_in_tooltip:false},unbreakable={},custom_data={jnv_pink_item:1b}]
item replace entity @s hotbar.3 with erraticlife:gift_box[custom_data={jnv_pink_item:true}] 8
item replace entity @s hotbar.5 with iron_pickaxe[enchantment_glint_override=false,enchantments={levels:{vanishing_curse:1},show_in_tooltip:false},unbreakable={},custom_data={jnv_pink_item:1b}]
